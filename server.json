{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.diyaluo/excel-toolkit-mcp",
  "description": "Excel formula generation plus CSV/XLSX cleaning MCP server, local-only.",
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "oci",
      "identifier": "ghcr.io/diyaluo/excel-toolkit-mcp:v0.1.0",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "docker",
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "run"
        },
        {
          "type": "positional",
          "value": "-i"
        },
        {
          "type": "positional",
          "value": "--rm"
        },
        {
          "type": "positional",
          "value": "ghcr.io/diyaluo/excel-toolkit-mcp:v0.1.0"
        }
      ]
    }
  ],
  "tools": [
    {
      "name": "generate_formula"
    },
    {
      "name": "clean_table"
    }
  ]
}